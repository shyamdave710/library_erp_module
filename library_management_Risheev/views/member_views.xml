<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
<!--    FORM VIEW -->
    <record id="view_library_member_form" model="ir.ui.view">
        <field name="name">library.member.form</field>
        <field name="model">library.member</field>
        <field name="arch" type="xml">

            <form string="Library Member">
                <header>
<!--                    Status indicator - not buttons, just a visual badge -->
                    <field name="is_expired" invisible="1" />
                    <div class="alert alert-danger"
                           role="alert"
                           invisible="not is_expired">
                        ⚠️ This member's membership has <strong>expired</strong>.
                        They cannot borrow books until renewed.
                    </div>
                </header>
                <sheet>
<!--                    photo + name -->
                    <field name="photo"
                    widget="image"
                    class="oe_avatar"
                    options="{'preview_image':'photo'}"/>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Member Full Name"/>
                        </h1>
                        <h4>
                            <field name="member_id" class="oe_read_only"/>
                        </h4>
                    </div>

<!--                    Exploring warning banner -->
                    <div class="alert alert-wearing mb-3"
                         role="alert"
                         invisible="not is_expired">
                        Membership expired. Books currently borrowed:
                        <strong><field name="active_issue_count" nolabel="1"/></strong>
                    </div>

                    <group>
                        <group string="Personal Information">
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="date_of_birth"/>
                            <field name="age" />
                            <field name="user_id" group="group_library_admin"/>
<!--                            only the admin can set/see which user account is linked to this member
                                librarian don't need to see this technical field
-->
                        </group>
                        <group string="Membership Details">
                            <field name="membership_type"/>
                            <field name="membership_start"/>
                            <field name="max_books_allowed"/>
                            <field name="active_issue_count"
                                   widget="statinfo"
                                   string="Currently Borrowed"/>
<!--                            widget="statinfo" shows the number
                                as a highlighted stat box
                                great for important counts
-->
                        </group>
                    </group>

<!--                    Issue History Tab   -->
                    <notebook>
                        <page string="Borrowed Books"
                              name="borrowed_tab">
                            <field name="issue_ids">
                                <list decoration-danger="state == 'overdue'"
                                      decoration-success="state == 'returned'"
                                      decoration-warning="state == 'issued'">
                                    <field name="reference"/>
                                    <field name="book_id"/>
                                    <field name="issue_date"/>
                                    <field name="due_date"/>
                                    <field name="return_date"/>
                                    <field name="state"
                                           widget="badge"
                                           decoration-success="state == 'returned'"
                                           decoration-danger="state in ('overdue', 'lost')"
                                           decoration-warning="state == 'issued'"
                                           decoration-info="state == 'draft'"/>
<!--                                widget='badge' shows selection field
                                    as a colored pil badge instead of plain text
                                    decoration-on badge changes color    -->

                                    <field name="fine_amount"/>
                                    <field name="fine_paid"
                                           widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

<!--    LIST VIEW -->
    <record id="view_library_member_list" model="ir.ui.view">
        <field name="name">library.member.list</field>
        <field name="model">library.member</field>
        <field name="arch" type="xml">
            <list string="member"
                  decoration-danger="is_expired == True"
                  decoration-muted="active_issue_count == 0">
                <field name="member_id"/>
                <field name="photo" widget="image"
                       options="{'size':[38,38]}"
                       string="Photo"/>
                <field name="name" />
                <field name="membership_type" widget="badge"
                       decoration-info="membership_type == 'student'"
                       decoration-success="membership_type == 'faculty'"
                       decoration-warning="membership_type == 'staff'"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="membership_end"/>
                <field name="active_issue_count"
                       string="Books Borrowed" />
                <field name="is_expired" widget="boolean_toggle"
                       optional="show" />
            </list>
        </field>
    </record>

<!--    KANBAN VIEW     -->
    <record id="view_library_member_kanban" model="ir.ui.view">
        <field name="name">library.member.kanban</field>
        <field name="model">library.member</field>
        <field name="arch" type="xml">

            <kanban default_group_by="membership_type">
                <field name="name"/>
                <field name="member_id"/>
                <field name="photo"/>
                <field name="membership_type"/>
                <field name="active_issue_count"/>
                <field name="is_expired"/>
                <field name="membership_end"/>
                <field name="max_books_allowed"/>

                <templates>
                    <t t-name="card">
                        <div class="d-flex align-items-center mb-2">
                            <field name="photo"
                                   widget="image"
                                   class="rounded-circle me-2"
                                   options="{'size':[48,48]}"/>
                            <div class="flex-grow-1">
                                <strong><field name="name"/></strong>
                                <div class="text-muted small">
                                    <field name="member_id"/>
                                </div>
                            </div>
<!--                            Expired badge  -->
                            <span t-if="record.is_expired.raw_value"
                                  class="badge bg-danger">Expired</span>
                            <span t-else="" class="badge bg-success">Active</span>
                        </div>
<!--                        Books borrowed progress -->
                        <div class="d-flex justify-content-between small mt-1">
                            <span>
                                <i class="fa fa-book me-1"/>
                                <field name="active_issue_count"/> /
                                <field name="max_books_allowed"/> books
                            </span>
                            <span class="text-muted">
                                Expires : <field name="membership_end"/>
                            </span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

<!--    SEARCH VIEW -->
    <record id="view_library_member_search" model="ir.ui.view">
        <field name="name">library.member.search</field>
        <field name="model">library.member</field>
        <field name="arch" type="xml">
            <search string="Search Members">
                <field name="name"/>
                <field name="member_id"/>
                <field name="email"/>
                <separator/>
                <filter string="Active Members" name="filter_active"
                        domain="[('is_expired','=',False)]"/>
                <filter string="Expired Members" name="filter_expired"
                        domain="[('is_expired','=',True)]"/>
                <filter string="Currently Borrowing" name="filter_borrowing"
                        domain="[('active_issue_count','>',0)]"/>
                <separator/>
                <filter string="Group by Membership Type" name="group_type"
                        context="{'group_by':'membership_type'}"/>
                <searchpanel>
                    <field name="membership_type" string="Membership Type"
                           icon="fa-users" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

<!--    ACTION + MENU WIRING    -->
    <record id="action_library_member" model="ir.actions.act_window">
        <field name="name">Members</field>
        <field name="res_model">library.member</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_library_member_search"/>
        <field name="context">{'search_default_filter_active':1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register your first library member..!!
            </p>
        </field>
    </record>
</odoo>