<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_library_book_form" model="ir.ui.view">
        <field name="name">library.book.form</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <form string="Library Book">
                <header>
                    <field name="is_available" widget="boolean_button"
                           options="{'terminology': 'active'}"/>
                </header>
                <sheet>
                    <field name="cover_image" widget="image" class="oe_avatar"
                           options="{'preview_image': 'cover_image'}"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Enter Book Title..." nolabel="1"/></h1>
                        <h3><field name="author" placeholder="Author Name" nolabel="1"/></h3>
                        <div><field name="reference" class="oe_read_only"/></div>
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="not is_reference_only">
                        This is a <strong>Reference Only</strong> book.
                        It cannot be issued to members.
                    </div>
                    <group>
                        <group string="Book Information">
                            <field name="genre"/>
                            <field name="language"/>
                            <field name="isbn"/>
                            <field name="published_date"/>
                            <field name="total_pages"/>
                            <field name="price"/>
                        </group>
                        <group string="Library Details">
                            <field name="rack_id"/>
                            <field name="is_available"/>
                            <field name="is_reference_only"/>
                            <field name="total_issue"/>
                            <field name="tag_ids" widget="many2many_tags"
                                   options="{'color_field': 'color'}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description_tab">
                            <field name="description" placeholder="Write the book synopsis here..."/>
                        </page>
                        <page string="Internal Notes" name="notes_tab">
                            <field name="notes"/>
                        </page>
                        <page string="Issue History" name="issues_tab"
                              invisible="total_issue == 0">
                            <field name="issue_ids" readonly="1">
                                <list>
                                    <field name="reference"/>
                                    <field name="member_id"/>
                                    <field name="issue_date"/>
                                    <field name="due_date"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>


    <record id="view_library_book_list" model="ir.ui.view">
        <field name="name">library.book.list</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <list string="Books"
                  decoration-success="is_available == True"
                  decoration-danger="is_available == False"
                  decoration-muted="is_reference_only == True">
                <field name="reference" optional="show"/>
                <field name="cover_image" widget="image" options="{'size': [38,38]}" string="Cover"/>
                <field name="name"/>
                <field name="author"/>
                <field name="genre"/>
                <field name="rack_id" optional="show"/>
                <field name="total_issue"/>
                <field name="is_available" widget="boolean_toggle"/>
                <field name="is_reference_only" optional="hide"/>
                <field name="tag_ids" widget="many2many_tags"
                       options="{'color_field': 'color'}" optional="show"/>
            </list>
        </field>
    </record>


    <record id="view_library_book_kanban" model="ir.ui.view">
        <field name="name">library.book.kanban</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <kanban default_group_by="genre" class="o_kanban_small_column">
                <field name="name"/>
                <field name="author"/>
                <field name="genre"/>
                <field name="is_available"/>
                <field name="is_reference_only"/>
                <field name="cover_image"/>
                <field name="tag_ids"/>
                <field name="total_issue"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex align-items-center mb-2">
                            <field name="cover_image" widget="image"
                                   class="rounded me-2" options="{'size': [48,48]}"/>
                            <div class="flex-grow-1">
                                <strong><field name="name"/></strong>
                                <div class="text-muted small"><field name="author"/></div>
                            </div>
                            <span t-if="record.is_available.raw_value" class="badge bg-success">Available</span>
                            <span t-else="" class="badge bg-danger">Issued</span>
                        </div>
                        <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        <div class="text-muted small mt-1">
                            <i class="fa fa-book me-1"/>
                            Issued <field name="total_issue"/> times
                            <t t-if="record.is_reference_only.raw_value">
                                <span class="text-warning"><i class="fa fa-lock"/> Reference Only</span>
                            </t>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_library_book_search" model="ir.ui.view">
        <field name="name">library.book.search</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <search string="Search Books">
                <field name="name" string="Title"/>
                <field name="author"/>
                <field name="isbn"/>
                <field name="reference"/>
                <field name="rack_id"/>
                <separator/>
                <filter string="Available Books" name="filter_available"
                        domain="[('is_available','=',True)]"/>
                <filter string="Currently Issued" name="filter_issued"
                        domain="[('is_available','=',False)]"/>
                <filter string="Reference Only" name="filter_reference"
                        domain="[('is_reference_only','=',True)]"/>
                <filter string="Fiction" name="filter_fiction"
                        domain="[('genre','=','Fiction')]"/>
                <separator/>
                <filter string="Added This Month" name="filter_this_month"
                        domain="[('date_added','&gt;=', (context_today()).strftime('%Y-%m-01'))]"/>
                <filter string="Group by Genre" name="group_genre"
                        context="{'group_by': 'genre'}"/>
                <filter string="Group by Author" name="group_author"
                        context="{'group_by': 'author'}"/>
                <filter string="Group by Rack" name="group_rack"
                        context="{'group_by': 'rack_id'}"/>
                <filter string="Group by Language" name="group_language"
                        context="{'group_by': 'language'}"/>
                <searchpanel>
                    <field name="rack_id" string="Rack"
                           icon="fa-archive" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>
    <record id="action_library_book" model="ir.actions.act_window">
        <field name="name">Books</field>
        <field name="res_model">library.book</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_library_book_search"/>
        <field name="context">{'search_default_filter_available': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first book to the library!</p>
            <p>Create a book catalog to manage your library collection.</p>
        </field>
    </record>

</odoo>